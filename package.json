{
  "name": "brownie-picker",
  "version": "1.0.0",
  "description": "Photograph the café brownie board and find the biggest piece",
  "scripts": {
    "copy-opencv": "node scripts/copy-opencv.mjs",
    "predev": "npm run copy-opencv",
    "dev": "vite",
    "dev:phone": "npm run copy-opencv && vite --mode phone --host",
    "prebuild": "npm run copy-opencv",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "synth": "vite-node scripts/make-synth.ts",
    "batch": "npm run copy-opencv && vite --open /batch.html",
    "debug": "vite-node scripts/debug-image.ts --"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@techstark/opencv-js": "^4.10.0-release.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "jpeg-js": "^0.4.4",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "private": true
}
